{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:morrowdock:schema:agent-request:1.0.0-draft.1",
  "title": "Morrowdock Materials inbox request",
  "description": "A request from Morrowdock (the owner, the app or the laptop link) to a linked agent. The ask is plain text written by the owner or the app. Agents answer with agent-item records of kind answer and inReplyTo set to this id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "kind", "ask", "synthetic", "createdBy", "createdAt", "expiresAt", "status"],
  "properties": {
    "schema": {"const": "morrowdock.agent-request/v1"},
    "schemaVersion": {"const": "1.0.0-draft.1"},
    "id": {"$ref": "#/$defs/uuid"},
    "kind": {"enum": ["fetch", "check-changes", "summarize"]},
    "ask": {"type": "string", "minLength": 1, "maxLength": 500},
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z]{2,6} ?[0-9]{2,4}[A-Z]?$"},
        "canvasCourseId": {"type": "integer", "minimum": 1}
      }
    },
    "since": {"$ref": "#/$defs/dateTime"},
    "synthetic": {"type": "boolean"},
    "syntheticScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "realAcademicFacts"],
      "properties": {
        "scope": {"const": "fixture-only"},
        "realAcademicFacts": {"const": false}
      }
    },
    "createdBy": {"enum": ["owner", "app", "laptop"]},
    "createdAt": {"$ref": "#/$defs/dateTime"},
    "expiresAt": {"$ref": "#/$defs/dateTime"},
    "status": {"enum": ["open", "answered", "expired"]},
    "answeredBy": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/uuid"}}
  },
  "allOf": [
    {"if": {"properties": {"synthetic": {"const": true}}}, "then": {"required": ["syntheticScope"]}, "else": {"not": {"required": ["syntheticScope"]}}},
    {"if": {"properties": {"status": {"const": "answered"}}}, "then": {"required": ["answeredBy"]}}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "dateTime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,6})?)?(Z|[+-][0-9]{2}:[0-9]{2})$"}
  }
}
